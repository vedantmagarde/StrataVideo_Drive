PORT=5000
FRONTEND_URL=http://localhost:5173

# Database Connection
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Firebase Admin (Individual Fields)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Alternatively, you can use a Base64 encoded Service Account JSON:
# FIREBASE_SERVICE_ACCOUNT=base64_encoded_firebase_json_here

# Google / YouTube OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:5000/api/youtube/callback

# Background Jobs / Email
UPSTASH_REDIS_URL=redis://localhost:6379
RESEND_API_KEY=your_resend_api_key
